# Local mock credentials only. Keep control ports bound to loopback.
POSTGRES_PASSWORD=local-admin-only
ORDERS_DB_PASSWORD=local-orders-only
INVENTORY_DB_PASSWORD=local-inventory-only
PAYMENTS_DB_PASSWORD=local-payments-only
CONTROL_TOKEN=local-control-only
LOCAL_UID=1000
LOCAL_GID=1000
ENVIRONMENT=local
GATEWAY_PORT=8000
ORDERS_PORT=8001
INVENTORY_PORT=8002
PAYMENTS_PORT=8003
CONTROLLER_PORT=8090
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
JAEGER_PORT=16686
JAEGER_MAX_TRACES=2000
LOKI_PORT=3100
GRAFANA_PORT=3000
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317
COLLECTOR_METRICS_PORT=8889
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318
TRACE_SAMPLE_RATIO=1
DB_POOL_MAX=4
DB_POOL_TIMEOUT=0.5
DB_QUERY_TIMEOUT=3
DEPENDENCY_TIMEOUT=4
# Fixed infrastructure safety timeouts: OTLP HTTP 1s, controller HTTP 3s,
# traffic HTTP 12s, health probes 2s, DB pool shutdown 5s, graceful shutdown 15s.
# Gateway has a larger timeout than Orders' two bounded dependency attempts.
GATEWAY_DEPENDENCY_TIMEOUT=12
BASELINE_DECLINE_RATE=0.02
TRAFFIC_RPS=4
TRAFFIC_CONCURRENCY=16
TRAFFIC_SEED=42
# legacy | checkout (multi-item carts with replays; needs orders migrations 001-003)
TRAFFIC_FLOW=legacy
# Optional 0-65535: pins checkout attempt references for a repeatable run (empty: random per run)
TRAFFIC_RUN_PREFIX=
# In-container URLs. Service databases are separate and have separate owners.
ORDERS_URL=http://orders:8001
INVENTORY_URL=http://inventory:8002
PAYMENTS_URL=http://payments:8003
# Controller schedule is configured in POST /faults/auto/start, not on application services.
# Defaults: seed=42, warmup_seconds=120, duration_seconds=120, recovery_seconds=90, repeat=1.
# Maximum duration_seconds=1800; hold_seconds<=15; failure_rate=0..1; delay_seconds=1..2.
