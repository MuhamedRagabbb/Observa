{
  "uid": "observa-overview", "title": "OBSERVA — Commerce signals", "schemaVersion": 40,
  "version": 1, "refresh": "5s", "time": {"from": "now-15m", "to": "now"},
  "tags": ["observa"], "panels": [
    {"id": 1, "title": "Requests / second", "type": "timeseries", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos":{"x":0,"y":0,"w":12,"h":8}, "targets":[{"refId":"A","expr":"sum by (service_name) (rate(http_server_requests_total[1m]))","legendFormat":"{{service_name}}"}]},
    {"id": 2, "title": "Server error ratio", "type": "timeseries", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos":{"x":12,"y":0,"w":12,"h":8}, "fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}}, "targets":[{"refId":"A","expr":"sum by (service_name) (rate(http_server_requests_total{http_status_code=~\"5..\"}[1m])) / sum by (service_name) (rate(http_server_requests_total[1m]))","legendFormat":"{{service_name}}"}]},
    {"id": 3, "title": "Request latency p95", "type": "timeseries", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos":{"x":0,"y":8,"w":12,"h":8}, "fieldConfig":{"defaults":{"unit":"s"}}, "targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le,service_name) (rate(http_server_duration_seconds_bucket[1m])))","legendFormat":"{{service_name}}"}]},
    {"id": 4, "title": "Orders DB pool utilization", "type": "timeseries", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos":{"x":12,"y":8,"w":12,"h":8}, "fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}}, "targets":[{"refId":"A","expr":"db_pool_active{service_name=\"orders-service\"} / db_pool_max{service_name=\"orders-service\"}","legendFormat":"active / max"}]},
    {"id": 5, "title": "Orders pool timeouts / second", "type": "timeseries", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos":{"x":0,"y":16,"w":8,"h":7}, "targets":[{"refId":"A","expr":"rate(db_pool_timeouts_total{service_name=\"orders-service\"}[1m])"}]},
    {"id": 6, "title": "Payment failures / second", "type": "timeseries", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos":{"x":8,"y":16,"w":8,"h":7}, "targets":[{"refId":"A","expr":"sum by (outcome) (rate(payments_failed_total[1m]))","legendFormat":"{{outcome}}"}]},
    {"id": 7, "title": "Process memory", "type": "timeseries", "datasource": {"type":"prometheus","uid":"prometheus"}, "gridPos":{"x":16,"y":16,"w":8,"h":7}, "fieldConfig":{"defaults":{"unit":"bytes"}}, "targets":[{"refId":"A","expr":"process_memory_usage_bytes","legendFormat":"{{service_name}}"}]},
    {"id": 8, "title": "Application logs — trace IDs link to Jaeger", "type": "logs", "datasource": {"type":"loki","uid":"loki"}, "gridPos":{"x":0,"y":23,"w":24,"h":12}, "options":{"showTime":true,"wrapLogMessage":true,"sortOrder":"Descending"}, "targets":[{"refId":"A","expr":"{service_name=~\"api-gateway|orders-service|inventory-service|payments-service\"} | json","queryType":"range"}]}
  ]
}
