{% extends "base.html.j2" %}
{% from "_macros.html.j2" import status_pill %}
{% block content %}
<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-50">Incident reports</h1>
    <p class="mt-1 text-sm text-slate-400">The current version of each report. Every version stays a draft until a human reviews it.</p>
  </div>
  <span class="rounded-full border border-slate-800 bg-slate-900 px-3 py-1 font-mono text-xs text-slate-400">{{ cards | length }} report{{ "" if cards | length == 1 else "s" }}</span>
</div>
{% if not cards %}
<div class="rounded-xl border border-dashed border-slate-700 bg-slate-900/50 p-10 text-center text-sm text-slate-400">
  No reports yet. Seed demo data with <code class="font-mono text-slate-300">python -m observa_review_service.seed</code>.
</div>
{% endif %}
<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  {% for card in cards %}
  {% set v = card.version %}{% set c = card.content %}
  <a data-testid="report-card" href="/ui/reports/{{ v.report_id }}" class="group flex flex-col rounded-xl border border-slate-800 bg-slate-900 p-5 transition hover:border-slate-700 hover:bg-slate-900/80">
    <div class="flex items-start justify-between gap-3">
      <span class="font-mono text-xs text-slate-500">{{ v.incident_id }}</span>
      {{ status_pill(v.review_status, "card-status") }}
    </div>
    <h2 class="mt-3 text-base font-semibold text-slate-100 group-hover:text-white">{{ c.overview.title }}</h2>
    <p class="mt-2 line-clamp-3 text-sm text-slate-400">{{ c.executive_summary }}</p>
    <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-800 pt-4 text-xs text-slate-400">
      <span class="rounded-md bg-slate-800 px-2 py-0.5 font-mono text-slate-300">v{{ v.version }}</span>
      <span>{{ c.overview.affected_services | join(", ") }}</span>
      {% for flag in v.uncertainty_flags %}<span class="rounded-md border border-amber-500/30 px-1.5 py-0.5 text-amber-300/90">{{ flag | replace("_", " ") }}</span>{% endfor %}
    </div>
  </a>
  {% endfor %}
</div>
{% endblock %}
