<!doctype html>
<html lang="en" class="dark h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}OBSERVA · Incident review{% endblock %}</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%2338bdf8'/%3E%3Ctext x='16' y='22' font-family='monospace' font-size='18' font-weight='700' text-anchor='middle' fill='%23020617'%3EO%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com/3.4.17?plugins=typography"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: { extend: { fontFamily: {
        sans: ["Inter", "ui-sans-serif", "system-ui", "sans-serif"],
        mono: ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"],
      } } },
    };
  </script>
</head>
<body class="min-h-full bg-slate-950 font-sans text-slate-200 antialiased selection:bg-sky-500/30">
  <header class="sticky top-0 z-30 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/ui" class="flex items-center gap-2.5">
        <span class="grid h-7 w-7 place-items-center rounded-lg bg-gradient-to-br from-sky-500 to-teal-400 font-mono text-xs font-bold text-slate-950">O</span>
        <span class="text-sm font-semibold tracking-wide text-slate-100">OBSERVA</span>
        <span class="hidden text-sm text-slate-500 sm:inline">· Incident review</span>
      </a>
      <nav class="flex items-center gap-4 text-sm">
        <a href="/ui" class="text-slate-400 transition hover:text-slate-100">Reports</a>
        <a href="/docs" class="text-slate-400 transition hover:text-slate-100">API</a>
        {% if viewer %}
        <span data-testid="signed-in-as" class="hidden font-mono text-xs text-slate-500 sm:inline">{{ viewer.reviewer_id }}</span>
        <form method="post" action="/ui/logout"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit" class="text-slate-400 transition hover:text-slate-100">Sign out</button></form>
        {% elif sign_in_configured %}
        <a href="/ui/login" class="text-sky-300 transition hover:text-sky-200">Sign in</a>
        {% endif %}
      </nav>
    </div>
  </header>
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    {% block content %}{% endblock %}
  </main>
</body>
</html>
