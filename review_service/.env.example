# OBSERVA review service settings. Copy to review_service/.env (git-ignored) and fill in the blanks.
# Compose overrides DATABASE_URL, MEMORY_SINK_DIR and REVIEWERS_FILE with container paths.

# Where reports, review state and the outbox live (SQLite now; a postgresql+psycopg URL works too).
DATABASE_URL=sqlite:///./data/review.sqlite3

# Review loop limits. All counts are read from the database, so restarts never reset them.
MAX_REVIEW_CYCLES=3
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=60

# Feedback interpretation: "fake" (deterministic, no network) or "groq" (needs GROQ_API_KEY).
INTERPRETER=fake
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Reviewer identities: a JSON file of sha256 token hashes (see reviewers.example.json).
REVIEWERS_FILE=reviewers.json

# Signs the dashboard session cookie. Without it each restart signs everyone out.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# sha256 of the Bearer token that F7/F2 use for /internal/v1/*. Empty keeps those endpoints closed.
# python -c "import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" <service-token>
SERVICE_TOKEN_SHA256=

# Where the F5 (memory) stand-in writes one JSON file per approved decision.
MEMORY_SINK_DIR=./data/memory
